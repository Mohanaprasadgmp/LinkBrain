{
  "manifest_version": 3,
  "name": "LinkBrain",
  "version": "0.1.0",
  "description": "Save the page you're on straight to your LinkBrain library.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to LinkBrain",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*"]
  }
}
