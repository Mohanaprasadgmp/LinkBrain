# LinkBrain environment variables
#
# Copy this file to .env.local and fill in real values there. .env.local is
# gitignored — never commit real credentials.

# Phase 2: PostgreSQL connection string from Neon.
#
# Use the "pooled" connection string from your Neon project's dashboard
# (Connection Details -> uses PgBouncer), not the "direct" one — the pooled
# string avoids exhausting Postgres's connection limit as the app scales.
# It already includes `sslmode=require`, which Neon requires.
#
# Example shape (not a real value):
#   postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/linkbrain?sslmode=require
DATABASE_URL=

# Phase 5: Better Auth (email/password + Google sign-in).
#
# BETTER_AUTH_SECRET encrypts sessions — generate one with, e.g., `openssl
# rand -base64 32`. Use a different value per environment; never reuse dev's
# in production.
BETTER_AUTH_SECRET=

# This app's own base URL. Used to build the OAuth callback URL
# (`{BETTER_AUTH_URL}/api/auth/callback/google`) — register that exact URL as
# an authorized redirect URI in the Google Cloud Console. Also reused by
# Phase 6's `app/api/extension/*` routes to build absolute "open this link"
# URLs for the Chrome extension — no separate app-URL variable needed.
BETTER_AUTH_URL=http://localhost:3000

# From a Google Cloud Console OAuth 2.0 Client ID (type: Web application).
# Leave both blank to disable Google sign-in — the button still renders but
# shows a clear "not configured" message instead of attempting a broken
# redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Comma-separated extra origins Better Auth should trust for
# CSRF/origin checks, beyond BETTER_AUTH_URL's own origin (which is always
# trusted automatically). Only useful during a domain transition — e.g. a
# Vercel-provided *.vercel.app URL and a custom domain both need to work at
# once. Leave unset otherwise.
#   BETTER_AUTH_TRUSTED_ORIGINS=https://my-app.vercel.app
BETTER_AUTH_TRUSTED_ORIGINS=

# Phase 7: OpenAI-powered AI enrichment (summary/category/topics/key points).
#
# OPENAI_API_KEY is server-only — never exposed to the browser, the Chrome
# extension, or any NEXT_PUBLIC_* variable (see lib/ai/openai-client.ts).
# Leave it unset to disable AI entirely: links still save normally, no AI
# insight row is ever created, and no OpenAI request is ever made — this is
# also exactly why the automated test suite needs no key at all.
OPENAI_API_KEY=

# Cost-conscious default (see docs/ARCHITECTURE.md's "AI enrichment"
# section for why). Configurable without a code change; never hardcoded
# elsewhere in the app.
OPENAI_MODEL=gpt-5.6-luna

# Later phases:
#   VECTOR_DB_URL=               # related-links / semantic search

# --- Vercel deployment note ---
# All of the above (DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL,
# GOOGLE_CLIENT_ID/SECRET) must be set in Vercel's Project Settings ->
# Environment Variables, for the Production environment. lib/auth.ts
# constructs the Better Auth instance eagerly at module load, so these are
# needed at BUILD time, not just at runtime — the build itself fails without
# them, not just requests after deploy. See docs/ARCHITECTURE.md's "Hosting
# and production configuration" section.
