# LinkBrain environment variables
#
# Phase 1 (this phase) makes no network calls and needs no environment
# variables — the app runs entirely on mock data. This file exists so the
# variables introduced in later phases have a documented home from day one:
#
#   DATABASE_URL=                # Phase 2: persistence
#   NEXTAUTH_SECRET=             # Phase 2: authentication
#   ANTHROPIC_API_KEY=           # Later phase: AI categorisation, summaries, Q&A
#   VECTOR_DB_URL=               # Later phase: related-links / semantic search
