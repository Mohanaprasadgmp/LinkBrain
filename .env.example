# LinkBrain environment variables
#
# Copy this file to .env.local and fill in real values there. .env.local is
# gitignored — never commit real credentials.

# Phase 2: PostgreSQL connection string from Neon.
#
# Use the "pooled" connection string from your Neon project's dashboard
# (Connection Details -> uses PgBouncer), not the "direct" one — the pooled
# string avoids exhausting Postgres's connection limit as the app scales.
# It already includes `sslmode=require`, which Neon requires.
#
# Example shape (not a real value):
#   postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/linkbrain?sslmode=require
DATABASE_URL=

# Phase 5: Better Auth (email/password + Google sign-in).
#
# BETTER_AUTH_SECRET encrypts sessions — generate one with, e.g., `openssl
# rand -base64 32`. Use a different value per environment; never reuse dev's
# in production.
BETTER_AUTH_SECRET=

# This app's own base URL. Used to build the OAuth callback URL
# (`{BETTER_AUTH_URL}/api/auth/callback/google`) — register that exact URL as
# an authorized redirect URI in the Google Cloud Console.
BETTER_AUTH_URL=http://localhost:3000

# From a Google Cloud Console OAuth 2.0 Client ID (type: Web application).
# Leave both blank to disable Google sign-in — the button still renders but
# shows a clear "not configured" message instead of attempting a broken
# redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Later phases:
#   ANTHROPIC_API_KEY=           # AI categorisation, summaries, Q&A
#   VECTOR_DB_URL=               # related-links / semantic search
